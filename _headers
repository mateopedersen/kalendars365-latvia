/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://bauval.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://bauval.org https://static.nresystems.com; font-src 'self'; connect-src 'self' https://bauval.org https://tiles.openfreemap.org https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://docs.google.com https://accounts.google.com https://bauval.org; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' mailto:
/assets/:file
  Cache-Control: public, max-age=3600
/downloads/*
  Cache-Control: public, max-age=86400

/assets/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/static/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/cities/*
  Cache-Control: public, max-age=604800

/assets/calendar-previews/*
  Cache-Control: public, max-age=31536000, immutable

/assets/related-previews/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=900, must-revalidate

/image-sitemap.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=900, must-revalidate

/*.ics
  Content-Type: text/calendar; charset=utf-8
  Content-Disposition: attachment
